/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EMBL-EBI Codon: resources per process
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Loaded by the codon_slurm profile (nextflow.config). Sized for a full build: ~1,800
    genomes, the whole PANTHER 16.0 library and a base tree with ~1,700 leaves.
    Memory grows with every retry; the error strategy is set by the profile, and the
    per-process ones in conf/base.config (genomes dropped when MetaEuk or hmmsearch fail)
    still apply.
----------------------------------------------------------------------------------------
*/

process {

    // TODO: adjust the times after the first full build
    time = 1.d

    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }

    // ---- reference data ---------------------------------------------------------------
    withName: prepare_taxdb {
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = 4.h
    }
    withName: fetch_panther {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = 4.h
    }
    withName: concat_panther {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = 4.h
    }
    withName: genetic_codes {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = 1.h
    }

    // ---- genome selection -------------------------------------------------------------
    withName: 'get_group_summary|filter_release_date' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = 1.h
    }
    withName: zip_summary {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = 2.h
    }
    withName: 'download_genome|genome2faa' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = 2.h
    }
    withName: size_filter {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = 1.h
    }
    withName: 'choose_representative|genome_group' {
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = 4.h
    }
    withName: split_clades {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = 2.h
    }

    // ---- proteomes --------------------------------------------------------------------
    withName: metaeuk_db {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = 4.h
    }
    withName: metaeuk_pred {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = 16.h
    }

    // ---- calibration and search -------------------------------------------------------
    withName: 'hmmsearch_training|hmmsearch_GA' {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = 12.h
    }
    withName: optimize_bitscore {
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = 8.h
    }
    withName: insert_bitscore {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = 2.h
    }
    withName: hmmpress_GA {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = 2.h
    }

    // ---- SCMGs and placement markers --------------------------------------------------
    withName: 'get_SCMG|choose_tree_profiles' {
        cpus   = 1
        memory = { 32.GB * task.attempt }
        time   = 8.h
    }
    withName: reduce_taxinfo {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = 1.h
    }
    withName: 'hmmfetch|hmmfetch_db' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = 4.h
    }

    // ---- alignments and tree ----------------------------------------------------------
    withName: group_top_hit {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = 4.h
    }
    withName: concat_faa {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = 1.h
    }
    withName: famsa {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = 4.h
    }
    withName: trimal_named {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = 2.h
    }
    withName: 'filter_gappy_leaves|horizontal' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = 2.h
    }
    withName: hmmbuild {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = 2.h
    }
    withName: modelfinder {
        cpus   = 32
        memory = { 64.GB * task.attempt }
        time   = 2.d
    }
    withName: iqtree {
        cpus   = 32
        memory = { 64.GB * task.attempt }
        time   = 5.d
    }
    withName: fasttree {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = 1.d
    }
    withName: 'midpoint_root|itol_annotations' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = 1.h
    }

    // ---- database and report ----------------------------------------------------------
    withName: db {
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = 4.h
    }
    withName: build_report {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = 2.h
    }
    withName: package_db {
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = 8.h
    }

    // ---- testing (--mode testing) -----------------------------------------------------
    withName: simulate_mag {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = 1.h
    }
    withName: eukcc_single {
        cpus   = 8
        memory = { 36.GB * task.attempt }
        time   = 8.h
    }
    withName: 'sum_quality|compare_quality' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = 1.h
    }
}
