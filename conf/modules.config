/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-process options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    <outdir>/
      eukcc2_db_<name>/      the database EukCC reads (--db), with its own provenance/
      provenance/            every intermediate decision: genome lists, cut-offs, markers
      itol/<subdb>/          annotation files for the four trees
      metaeuk_db/            the MetaEuk reference database
      testing/               the evaluation report (--mode testing)
      pipeline_info/         Nextflow reports
----------------------------------------------------------------------------------------
*/

process {

    withName: get_group_summary {
        publishDir = [
            path: { "${params.outdir}/provenance/ncbi/summaries" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: zip_summary {
        publishDir = [
            path: { "${params.outdir}/provenance/ncbi" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: prepare_taxdb {
        publishDir = [
            path: { "${params.outdir}/provenance/taxonomy" },
            mode: params.publish_dir_mode,
            pattern: 'taxonomy.tsv',
        ]
    }

    withName: 'choose_representative|genome_group' {
        publishDir = [
            path: { "${params.outdir}/provenance/classification" },
            mode: params.publish_dir_mode,
            pattern: 'species_classification*.csv',
        ]
    }

    withName: optimize_bitscore {
        publishDir = [
            path: { "${params.outdir}/provenance/calibration" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: hmmsearch_GA {
        publishDir = [
            path: { "${params.outdir}/provenance/hmmGA/${clade}" },
            mode: params.publish_dir_mode,
            pattern: '*.tbl',
            enabled: params.publish_ga_tables,
        ]
    }

    withName: choose_tree_profiles {
        publishDir = [
            path: { "${params.outdir}/provenance/markers" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: filter_gappy_leaves {
        publishDir = [
            path: { "${params.outdir}/provenance/leaf_gaps" },
            mode: params.publish_dir_mode,
            pattern: 'leaf_gaps_*.tsv',
        ]
    }

    withName: modelfinder {
        publishDir = [
            path: { "${params.outdir}/provenance/modelfinder" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: build_report {
        publishDir = [
            path: { "${params.outdir}/provenance" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: itol_annotations {
        publishDir = [
            path: { "${params.outdir}/itol/${clade}" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: metaeuk_db {
        publishDir = [
            path: { "${params.outdir}/metaeuk_db" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: package_db {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: compare_quality {
        publishDir = [
            path: { "${params.outdir}/testing" },
            mode: params.publish_dir_mode,
        ]
    }
}
