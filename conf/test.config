/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Small machine: caps every task. Combine with -stub-run for a dry run of the whole
    graph on the files in tests/data:

        nextflow run . -profile test,docker -stub-run --outdir results_stub
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '8.GB',
        time: '2.h'
    ]
}

params {
    summaries                  = "${projectDir}/tests/data/summaries"
    panther                    = "${projectDir}/tests/data/panther"
    taxdb                      = "${projectDir}/tests/data/taxa.sqlite"
    taxdump                    = "${projectDir}/tests/data/taxdump.tar.gz"
}
