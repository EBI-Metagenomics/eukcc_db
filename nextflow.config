/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    eukcc-db Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

params {

    // Run
    mode                  = 'build'     // build | testing
    name                  = null        // release name: eukcc2_db_<name>/; null = YYYY_MM of cutoff_date, else of the run
    outdir                = null
    cachedir              = 'cache'     // storeDir: NCBI genomes and PANTHER, shared between runs
    publish_dir_mode      = 'copy'
    run_stamp             = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')   // pipeline_info/ file names: one set per run

    // NCBI genomes
    ncbi_url              = 'https://ftp.ncbi.nlm.nih.gov'
    divisions             = [['protozoa', 'genbank'], ['protozoa', 'refseq'],
                             ['plant', 'genbank'], ['plant', 'refseq'],
                             ['fungi', 'genbank'], ['fungi', 'refseq']]
    genbank_fill_groups   = ['fungi']   // groups where GenBank only fills phyla without any RefSeq species.
    summaries             = null        // dir with <catalogue>_<group>.txt instead of downloading
    cutoff_date           = null        // YYYY-MM-DD on seq_rel_date; null = NCBI on the day of the run
    minbp                 = 2000000     // Genome size. 2 Mb is just below the smallest nuclear genomes known Microsporidia, 2.2 Mb
    min_relative_size     = 0.1         // Minimum genome size as a fraction of the median of its genus (family when the genus has < 3 species with a size); null = off
    ncbi_maxforks         = 8           // parallel NCBI downloads (more earns HTTP 503)
    pilot_species         = null        // pilot run: keep only this many species per division, for tests
    exclude_genomes       = "${projectDir}/assets/exclude_genomes.tsv"   // accession<TAB>reason of bad references that never enter the database; false = none

    // Numbers from legacy code and thesis.
    holdout_size          = 30          // RefSeq species kept out of every database
    holdout_min_species   = 2           // this many species of every protected taxon always stay out of the hold-out
    holdout_protect_ranks = ['phylum', 'order']   // ranks the hold-out never empties
    metaeuk_size          = 25          // RefSeq proteomes in the MetaEuk reference
    calibration_size      = 45          // per sub-database, calibrate the bit score cut-offs

    // Taxonomy, using taxdump to avoid daily updates of the NCBI taxonomy database.
    taxdump               = null        // required: e.g. https://ftp.ncbi.nlm.nih.gov/pub/taxonomy/taxdump_archive/taxdmp_YYYY-MM-01.zip
    taxdb                 = null        // a ready taxa.sqlite instead of building one

    // PANTHER
    panther               = null        // dir holding books/; otherwise fetched from panther_url
    panther_version       = '16.0'
    panther_url           = 'https://data.pantherdb.org/ftp/panther_library/16.0/PANTHER16.0_ascii.tgz'

    // Bit score calibration (thesis)
    evalue                = '0.01'      // hmmsearch on the calibration genomes

    // Tree
    max_leaf_gap_fraction = 0.9         // drop leaves with more gaps in the concatenation; null = report only
    iqtree                = true        // false = FastTree
    modelfinder           = true        // select the model with ModelFinder; false = iqmodel
    modelfinder_clade     = 'base'      // sub-database ModelFinder runs on; its model feeds every tree
    iqmodel               = null        // required with modelfinder = false, e.g. LG+R7 (thesis)
    seed                  = 42          // IQ-TREE -seed
    publish_ga_tables     = true        // hmmsearch --cut_ga tables (~1 MB per genome and sub-database)

    // Testing workflow (thesis): simulated MAGs from the hold-out genomes
    db                    = null        // database under test (eukcc2_db_<name>/)
    classification        = null        // species_classification.csv of the build; default: <db>/provenance/
    eval_completeness     = [40, 50, 60, 70, 80, 90, 100]
    eval_contamination    = [0, 2.5, 5, 7.5, 10, 12.5]
    eval_n_repeats        = 3
    eval_n_mags           = 300
    eval_seed             = 273
    contamination_source  = 'self'      // source of contamination for hold-out genomes.
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    docker {
        docker.enabled       = true
        docker.runOptions    = '-u $(id -u):$(id -g)'
    }
    // Apple silicon: the images are linux/amd64 (-profile docker,arm)
    arm {
        docker.runOptions    = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    test {
        includeConfig 'conf/test.config'
    }
    // EMBL-EBI Codon (SLURM): -profile codon_slurm. Paths under /hps, the SLURM executor and
    // Singularity here; resources per process in conf/codon.config
    codon_slurm {
        params.workdir              = "/hps/nobackup/rdf/metagenomics/service-team/nextflow-workdir/eukcc_db/${params.name}/work"
        params.singularity_cachedir = "/hps/nobackup/rdf/metagenomics/service-team/singularity-cache/"
        params.cachedir             = "/hps/nobackup/rdf/metagenomics/service-team/nextflow-workdir/eukcc_db/cache"

        workDir = params.workdir

        executor {
            name              = "slurm"
            queueSize         = 200
            queueGlobalStatus = true
            submitRateLimit   = "10 sec"
            pollInterval      = "10 sec"
        }

        singularity {
            enabled     = true
            autoMounts  = true
            cacheDir    = params.singularity_cachedir
            runOptions  = '--containall --no-home'
            pullTimeout = "1h"
        }
        docker.enabled    = false

        process {
            errorStrategy = {
                task.exitStatus in ((130..145) + 104 + 247 + 250 + 1) && task.attempt <= 4 ? 'retry' : 'finish'
            }
            maxRetries    = 3

            queue  = 'standard'
            time   = 1.d
            cache  = 'lenient'
            cpus   = 1
            memory = 6.GB
        }

        includeConfig 'conf/codon.config'
    }
}

// Default registry of the biocontainers images, independent of -profile
docker.registry      = 'quay.io'
singularity.registry = 'quay.io'

// Keep local Python libraries out of the containers
env {
    PYTHONNOUSERSITE = 1
}

process.shell = [
    "bash",
    "-C",
    "-e",
    "-u",
    "-o",
    "pipefail",
]

nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.run_stamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.run_stamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.run_stamp}.txt"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,memory,time,realtime,%cpu,peak_rss'
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.run_stamp}.html"
}

manifest {
    name            = 'eukcc-db'
    description     = 'Builds the EukCC2 reference databases from NCBI genomes and PANTHER'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.04.0'
    version         = '1.0.0'
}

// Load modules.config for per-process options and publishing paths
includeConfig 'conf/modules.config'
